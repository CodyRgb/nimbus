# Server Port & Environment
PORT=5000
NODE_ENV=production

# MongoDB Database URI (e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/nimbus

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
JWT_EXPIRE=7d

# Telegram API & Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# Telegram Connection Resilience
TELEGRAM_MAX_RETRIES=3
TELEGRAM_RETRY_DELAY=1000
TELEGRAM_CONNECTION_RETRIES=25
TELEGRAM_CONNECTION_TIMEOUT=600
TELEGRAM_USE_WSS_FALLBACK=true
TELEGRAM_CONNECTION_POOL_SIZE=5
TELEGRAM_HEALTH_CHECK_INTERVAL=60000

# File Upload Limits (in bytes, 2GB = 2147483648)
MAX_FILE_SIZE=2147483648

# CORS Configuration (Comma-separated origins, or Vercel domain)
# Note: *.vercel.app and localhost are automatically allowed by server.ts
CORS_ORIGIN=https://your-nimbus-app.vercel.app,http://localhost:3000

# Cloudinary Configuration (Optional - for image thumbnails)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Optional - for password resets)
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SENDER_EMAIL=your_sender_email@domain.com
