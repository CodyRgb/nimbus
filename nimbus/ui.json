{
    "designSystem": {
        "meta": {
            "projectName": "Aurelia - Creative Agency Landing Page",
            "themeStyle": "Bold Neo-Brutalist / High-Contrast Modern Agency",
            "brandPersonality": [
                "Energetic",
                "Bold",
                "Innovative",
                "High-Impact",
                "Structured"
            ],
            "gridSystem": {
                "columns": 12,
                "maxWidth": "1320px",
                "gutter": "24px",
                "margin": "auto",
                "sectionPaddingVertical": "100px"
            }
        },
        "colorPalette": {
            "primary": {
                "electricRoyalBlue": {
                    "hex": "#0720C6",
                    "rgb": "rgb(7, 32, 198)",
                    "usage": "Hero background, active/featured cards, progress bars, inline text highlight pills, icon badges"
                },
                "acidLimeGreen": {
                    "hex": "#B8FE00",
                    "rgb": "rgb(184, 254, 0)",
                    "usage": "Display hero text, ticker tape background, circular action arrows, star icons, logomarks, inline text highlight pills"
                }
            },
            "backgrounds": {
                "deepCharcoal": {
                    "hex": "#16181B",
                    "rgb": "rgb(22, 24, 27)",
                    "usage": "Primary dark section backgrounds (Services, Statement, Awards, Testimonials, Newsletter, Footer)"
                },
                "elevatedDarkCard": {
                    "hex": "#202327",
                    "rgb": "rgb(32, 35, 39)",
                    "usage": "Default service cards, testimonial cards, logo bar container, dark process cards"
                },
                "offWhiteConcrete": {
                    "hex": "#F2F3F5",
                    "rgb": "rgb(242, 243, 245)",
                    "usage": "Light alternating sections (Who We Are, Portfolio, Team, Process, Blog) with subtle noise/halftone texture"
                },
                "pureWhite": {
                    "hex": "#FFFFFF",
                    "rgb": "rgb(255, 255, 255)",
                    "usage": "Card backgrounds in light sections, primary text on dark backgrounds"
                }
            },
            "typography": {
                "textLight": "#FFFFFF",
                "textMutedLight": "#A0A6B2",
                "textDark": "#141619",
                "textMutedDark": "#5A6065",
                "textAccentLime": "#B8FE00"
            },
            "bordersAndDividers": {
                "subtleLight": "rgba(255, 255, 255, 0.15)",
                "subtleDark": "rgba(20, 22, 25, 0.12)",
                "accentYellow": "#B8FE00"
            },
            "texturesAndOverlays": {
                "heroGridOverlay": "Subtle radial dot matrix + faint geometric wireframe grid at 8% opacity over #0720C6",
                "lightSectionTexture": "Subtle diagonal micro-line / concrete grain texture over #F2F3F5"
            }
        },
        "typography": {
            "fontFamilies": {
                "display": {
                    "primary": "Anton",
                    "fallbacks": [
                        "Impact",
                        "Bebas Neue",
                        "Oswald",
                        "sans-serif"
                    ],
                    "characteristics": "Ultra-condensed, heavy weight, all-caps, tight tracking, strong vertical presence"
                },
                "body": {
                    "primary": "Plus Jakarta Sans",
                    "fallbacks": [
                        "Inter",
                        "DM Sans",
                        "sans-serif"
                    ],
                    "characteristics": "Clean geometric grotesk, high legibility at small sizes"
                }
            },
            "scale": {
                "heroDisplay": {
                    "fontFamily": "display",
                    "fontSize": "clamp(5.5rem, 13vw, 11.5rem)",
                    "fontWeight": 800,
                    "lineHeight": 0.88,
                    "letterSpacing": "-0.02em",
                    "textTransform": "uppercase"
                },
                "footerWatermark": {
                    "fontFamily": "display",
                    "fontSize": "clamp(4rem, 11vw, 9.5rem)",
                    "fontWeight": 800,
                    "lineHeight": 0.85,
                    "textTransform": "uppercase",
                    "style": "1px stroke outline only, rgba(255,255,255,0.08) fill transparent"
                },
                "h1_sectionStatement": {
                    "fontFamily": "display",
                    "fontSize": "clamp(1.75rem, 3.2vw, 2.75rem)",
                    "fontWeight": 700,
                    "lineHeight": 1.25,
                    "letterSpacing": "0.01em",
                    "textTransform": "uppercase"
                },
                "h2_sectionTitle": {
                    "fontFamily": "display",
                    "fontSize": "clamp(2rem, 3.8vw, 3.25rem)",
                    "fontWeight": 700,
                    "lineHeight": 1.08,
                    "letterSpacing": "0.01em",
                    "textTransform": "uppercase"
                },
                "h3_cardTitle": {
                    "fontFamily": "display",
                    "fontSize": "1.5rem",
                    "fontWeight": 700,
                    "lineHeight": 1.15,
                    "textTransform": "uppercase"
                },
                "tickerText": {
                    "fontFamily": "display",
                    "fontSize": "1.85rem",
                    "fontWeight": 700,
                    "lineHeight": 1.0,
                    "letterSpacing": "0.02em",
                    "textTransform": "uppercase"
                },
                "statNumber": {
                    "fontFamily": "body",
                    "fontSize": "2.25rem",
                    "fontWeight": 800,
                    "lineHeight": 1.0
                },
                "eyebrowTag": {
                    "fontFamily": "display",
                    "fontSize": "0.85rem",
                    "fontWeight": 600,
                    "letterSpacing": "0.08em",
                    "textTransform": "uppercase"
                },
                "navLink": {
                    "fontFamily": "display",
                    "fontSize": "0.75rem",
                    "fontWeight": 500,
                    "letterSpacing": "0.06em",
                    "textTransform": "uppercase"
                },
                "bodyRegular": {
                    "fontFamily": "body",
                    "fontSize": "0.875rem",
                    "fontWeight": 400,
                    "lineHeight": 1.6
                },
                "buttonLabel": {
                    "fontFamily": "display",
                    "fontSize": "0.8rem",
                    "fontWeight": 600,
                    "letterSpacing": "0.06em",
                    "textTransform": "uppercase"
                }
            }
        },
        "uiComponents": {
            "sectionEyebrow": {
                "structure": "4-point star icon (#B8FE00) + uppercase label text",
                "gap": "8px",
                "alignment": "center-left"
            },
            "outlineButton": {
                "padding": "10px 20px",
                "border": "1px solid currentColor",
                "borderRadius": "0px",
                "background": "transparent",
                "typography": "buttonLabel",
                "icon": "Small right arrow inside circle or chevron"
            },
            "circleIconButton": {
                "size": "38px",
                "borderRadius": "50%",
                "background": "#B8FE00",
                "iconColor": "#141619",
                "iconType": "North-East diagonal arrow (↗)"
            },
            "textHighlightPill": {
                "padding": "2px 10px",
                "borderRadius": "20px",
                "variants": {
                    "blue": {
                        "background": "#0720C6",
                        "textColor": "#FFFFFF"
                    },
                    "lime": {
                        "background": "#B8FE00",
                        "textColor": "#141619"
                    }
                }
            },
            "inlineTextThumb": {
                "width": "64px",
                "height": "28px",
                "borderRadius": "14px",
                "objectFit": "cover",
                "verticalAlign": "middle"
            }
        }
    },
